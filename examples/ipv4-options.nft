# This drops IPv4 TCP packets whose IPv4 header contains options.
# Use a table name reserved for this extension when adapting the example.
table inet talos_nftables_demo {}
flush table inet talos_nftables_demo
table inet talos_nftables_demo {
  chain prerouting {
    type filter hook prerouting priority raw; policy accept;
    meta l4proto tcp ip hdrlength > 5 counter drop
  }
}
